# Java / Maven / Gradle build output
**/target/
**/build/
*.class

# Node / frontend dependencies and generated output
**/node_modules/
**/dist/
**/coverage/
**/.vitest/
# Playwright output and authentication state (never persist QA credentials)
**/test-results/
**/playwright-report/
**/playwright/.cache/
**/traces/
**/videos/
**/screenshots/
**/.auth/
**/storage-state*.json
**/auth-state*.json
**/*.trace.zip
**/secrets/**
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local configuration and secrets
.env
.env.*
!.env.example
**/application-local.properties
**/application-local.yml
**/application-local.yaml

# IDEs and editor files (keep shared VS Code recommendations/settings)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.iml

# Operating system files
.DS_Store
Thumbs.db
jar.txt
logs/

# Documentation: publish QA assets only.
# Keep private command references and AI prompts excluded.
docs/*
!docs/qa/

# Exclude QA credentials and authentication state.
docs/qa/**/.env
docs/qa/**/.env.*
docs/qa/**/*secret*
docs/qa/**/*credential*
docs/qa/**/*token*
docs/qa/**/secrets/
docs/qa/**/.auth/
docs/qa/**/storage-state*.json
docs/qa/**/auth-state*.json

# Exclude generated QA artifacts.
docs/qa/**/node_modules/
docs/qa/**/target/
docs/qa/**/coverage/
docs/qa/**/test-results/
docs/qa/**/playwright-report/
docs/qa/**/traces/
docs/qa/**/videos/
docs/qa/**/screenshots/
docs/qa/**/*.log
docs/qa/**/*.trace.zip
