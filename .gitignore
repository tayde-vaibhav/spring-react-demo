# Java / Maven / Gradle build output
**/target/
**/build/
*.class

# Node / frontend dependencies and generated output
**/node_modules/
**/dist/
**/coverage/
**/.vitest/
# Playwright output and authentication state (never persist QA credentials)
**/test-results/
**/playwright-report/
**/playwright/.cache/
**/traces/
**/videos/
**/screenshots/
**/.auth/
**/storage-state*.json
**/auth-state*.json
**/*.trace.zip
**/secrets/**
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local configuration and secrets
.env
.env.*
!.env.example
**/application-local.properties
**/application-local.yml
**/application-local.yaml

# IDEs and editor files (keep shared VS Code recommendations/settings)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.iml

# Operating system files
.DS_Store
Thumbs.db
jar.txt
logs/
docs/
