MONGODB_ROOT_USERNAME=local_admin
MONGODB_ROOT_PASSWORD=replace_with_url_safe_strong_password
MONGODB_DATABASE=springreactdemo
MONGODB_URI=mongodb://${MONGODB_ROOT_USERNAME}:${MONGODB_ROOT_PASSWORD}@localhost:27017/${MONGODB_DATABASE}?authSource=admin
JWT_SECRET=replace_with_at_least_32_random_bytes_for_hmac_signing
JWT_EXPIRY_SECONDS=900
LOGIN_RATE_LIMIT_WINDOW=15m
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEV_ADMIN_PASSWORD=replace_with_a_unique_strong_admin_password
DEV_USER_PASSWORD=replace_with_a_unique_strong_user_password
